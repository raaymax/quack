{
  "nodeModulesDir": "auto",
  "workspace": [
    "./deno/config",
    "./deno/server",
    "./deno/storage",
    "./deno/migrate",
    "./deno/encryption",
    "./deno/api",
    "./deno/tools",
    "./planigale/planigale",
    "./planigale/body-parser",
    "./planigale/querystring",
    "./planigale/schema",
    "./planigale/sse",
    "./planigale/testing"
  ],
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/fs": "jsr:@std/fs@1.0.17",
    "@std/path": "jsr:@std/path@1.1.2",
    "argon2": "npm:@node-rs/argon2@2.0.2",
    "mongodb": "npm:mongodb@6.19.0",
    "valibot": "npm:valibot@1.1.0"
  },
  "fmt": {
    "include": [
      "deno/**"
    ],
    "exclude": [
      "deno/server/uploads/**",
      "temp/**"
    ]
  },
  "lint": {
    "include": ["deno/"],
    "exclude": ["packages/", "deno/server/uploads/**", "**/node_modules/**", "app/.cache", "temp/**"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-unused-vars", "no-explicit-any", "require-await"]
    }
  },
  "test": {
    "exclude": [
      "deno/server/uploads/**",
      "**/node_modules/**",
      "app/.cache",
      "temp/**"
    ]
  },
  "tasks": {
    "cache": "deno task -c ./deno/server/deno.jsonc cache",
    "dev": "deno task -c ./deno/server/deno.jsonc dev",
    "web": "deno task -c ./app/deno.json dev",
    "start": "deno task -c ./deno/server/deno.jsonc start",
    "build": "deno task -c ./app/deno.json build",
    "migrate": "deno task -c ./deno/migrate/deno.json migrate up",
    "migrate:tests": "DATABASE_URL='mongodb://chat:chat@localhost:27017/tests?authSource=admin' deno task migrate",
    "test": "DATABASE_URL='mongodb://chat:chat@localhost:27017/tests?authSource=admin' deno test -A",
    "check": "deno fmt && deno lint && deno task test",
    "mobile:config": "deno run -A deno/tools/export-mobile-config.ts",
    "auth:status": "deno run -A deno/tools/auth-migration-status.ts"
  },
  "compilerOptions": {
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment"
  }
}
