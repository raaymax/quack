<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorAccent">#FF8C00</color>
    <color name="colorPrimary">#201F22</color>
    <color name="colorPrimaryDark">#1a1d21</color>
    <color name="ic_launcher_background">#FFFFFF</color>
    <string name="app_name">Quack</string>
    <string name="custom_url_scheme">io.codecat.quack</string>
    <string name="package_name">io.codecat.quack</string>
    <string name="title_activity_main">Quack</string>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>
</resources>