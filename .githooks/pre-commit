#!/bin/bash
# Git pre-commit hook that enforces using /commit command
#
# Install: git config core.hooksPath .githooks
# Or symlink: ln -sf ../../.githooks/pre-commit .git/hooks/pre-commit

# Allow bypass when running from /commit command
if [ "$CLAUDE_COMMIT" = "1" ]; then
    exit 0
fi

# Allow bypass for CI/CD environments
if [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ] || [ -n "$GITLAB_CI" ]; then
    exit 0
fi

# Allow bypass with explicit flag (for emergencies)
if [ "$SKIP_COMMIT_HOOK" = "1" ]; then
    echo "⚠️  Bypassing commit hook (SKIP_COMMIT_HOOK=1)"
    exit 0
fi

# Block direct git commit
echo ""
echo "╔════════════════════════════════════════════════════════════════╗"
echo "║  ⛔ Direct git commit is disabled                              ║"
echo "║                                                                ║"
echo "║  Please use the /commit command instead:                       ║"
echo "║                                                                ║"
echo "║    /commit                                                     ║"
echo "║                                                                ║"
echo "║  This ensures:                                                 ║"
echo "║    • Conventional commit format                                ║"
echo "║    • Pre-commit checks (lint, test, fmt)                       ║"
echo "║    • No AI attribution in commits                              ║"
echo "║    • Proper branch management                                  ║"
echo "║                                                                ║"
echo "║  Emergency bypass: SKIP_COMMIT_HOOK=1 git commit ...           ║"
echo "╚════════════════════════════════════════════════════════════════╝"
echo ""
exit 1
